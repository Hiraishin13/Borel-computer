# --- Database ---
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/borel-computer?retryWrites=true&w=majority"

# --- Auth (NextAuth + JWT) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
JWT_SECRET="generate-with: openssl rand -base64 32"

# --- Commande / WhatsApp (paiement espèces) ---
# Numéro qui reçoit les commandes, format international sans espaces ni "+"
NEXT_PUBLIC_WHATSAPP_NUMBER="22901234567"

# --- Stripe (optionnel, non utilisé par le checkout actuel) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# --- Email (Resend) ---
RESEND_API_KEY="re_xxx"
EMAIL_FROM="Borel Computer <noreply@borelcomputer.com>"

# --- Media (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# --- Analytics ---
NEXT_PUBLIC_POSTHOG_KEY="phc_xxx"
NEXT_PUBLIC_POSTHOG_HOST="https://eu.posthog.com"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
